#!/bin/sh

# Resolve symlinks so installs such as ~/bin/wt -> ~/.wt/bin/wt still find the
# source tree relative to the real launcher rather than the symlink location.
launcher=$0
while [ -L "$launcher" ]; do
  launcher_dir=$(CDPATH= cd -P -- "$(dirname -- "$launcher")" && pwd)
  launcher_target=$(readlink "$launcher")
  case $launcher_target in
    /*) launcher=$launcher_target ;;
    *) launcher=$launcher_dir/$launcher_target ;;
  esac
done

launcher_dir=$(CDPATH= cd -P -- "$(dirname -- "$launcher")" && pwd)
# `env -u BUN_INSPECT`: wt is most often run from INSIDE a Claude session,
# whose environment binds that session's inspector socket (the transport
# messages arrive through). bun honors BUN_INSPECT in every child, so an
# unscrubbed launch would have wt try to bind a socket its parent already
# owns — a 20-line EADDRINUSE stack on stderr for every `wt` an agent runs.
# See src/core/harness/claude/inject/shims.ts, which does the same for the
# other bun binaries an agent invokes.
#
# Non-interactive SSH commonly supplies only /usr/local/bin:/usr/bin:/bin,
# even when Bun was installed in its default ~/.bun/bin location. Remote wt
# commands and agent sessions must not depend on a login-shell PATH, so use
# that deterministic fallback when `bun` is otherwise unavailable.
bun_exe=$(command -v bun 2>/dev/null || true)
if [ -z "$bun_exe" ] && [ -x "$HOME/.bun/bin/bun" ]; then
  bun_exe="$HOME/.bun/bin/bun"
fi
if [ -z "$bun_exe" ]; then
  echo "wt: bun not found (checked PATH and $HOME/.bun/bin/bun)" >&2
  exit 127
fi
exec env -u BUN_INSPECT WT_LAUNCHER_DIR="$launcher_dir" \
  "$bun_exe" "$launcher_dir/../src/main.ts" "$@"
