{
  "name": "wt",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.0",
  "bin": {
    "wt": "./bin/wt"
  },
  "scripts": {
    "prepare": "effect-language-service patch",
    "lint": "effect-language-service diagnostics --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/main.ts --target bun --packages external --outdir dist",
    "start": "bun src/main.ts"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.14"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "0.5.1",
    "@opentui/react": "0.5.1",
    "@tanstack/query-persist-client-core": "^5.99.2",
    "@tanstack/react-query": "^5.99.2",
    "effect": "4.0.0-rc.112",
    "react": "^19.2.5",
    "unique-names-generator": "^4.7.1"
  }
}
